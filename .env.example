# Madira environment
# LLM provider is configurable. Default: openai / gpt-4.1-mini
MADIRA_LLM_PROVIDER=openai
MADIRA_LLM_MODEL=gpt-4.1-mini

# If no provider key is set, the app runs in labeled DEMO MODE
# with a deterministic fake model and fixtures.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MADIRA_API_KEY=

# Force demo even if a key is present (including one saved in Settings):
# MADIRA_DEMO_MODE=true

# Encrypts provider keys saved from the Settings page.
# Use a Fernet key, or any other secret string (it is stretched to a Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a dev-only key is written to backend/data/.madira_secret.
# Set this anywhere the database is shared. Saving a key fails if that file cannot be created.
# MADIRA_SECRET_KEY=

# Unlocks the Settings page and /settings/* . If unset, those endpoints refuse
# reads and writes until you set this and restart the backend.
# MADIRA_ADMIN_PASSWORD=

# Test only. accept skips the provider check and stores any key.
# Never set this in production.
# MADIRA_LLM_VALIDATOR=accept

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://madira:madira@localhost:5432/madira

MADIRA_FRONTEND_ORIGIN=http://localhost:3000
MADIRA_BACKEND_URL=http://127.0.0.1:8123
MADIRA_PORT=8123
