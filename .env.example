# Madira environment
# LLM provider is configurable. Default: openai / gpt-4.1-mini
MADIRA_LLM_PROVIDER=openai
MADIRA_LLM_MODEL=gpt-4.1-mini

# If no provider key is set, the app runs in labeled DEMO MODE
# with a deterministic fake model and fixtures.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MADIRA_API_KEY=

# Force demo even if a key is present (including one saved in Settings):
# MADIRA_DEMO_MODE=true

# Encrypts provider keys saved from the Settings page.
# Use a Fernet key, or any other secret string (it is stretched to a Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a dev-only key is written to backend/data/.madira_secret.
# Set this anywhere the database is shared. Saving a key fails if that file cannot be created.
# MADIRA_SECRET_KEY=

# Unlocks the Settings page and /settings/* . If unset, those endpoints refuse
# reads and writes until you set this and restart the backend.
# MADIRA_ADMIN_PASSWORD=

# Test only. accept skips the 1-token provider check and stores any key.
# The real check calls the chosen model once so a key with no credits or
# quota is rejected before it is saved. Never set this in production.
# MADIRA_LLM_VALIDATOR=accept

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://madira:madira@localhost:5432/madira

MADIRA_FRONTEND_ORIGIN=http://localhost:3000
MADIRA_BACKEND_URL=http://127.0.0.1:8123
MADIRA_PORT=8123

# Google sign-in (OpenID Connect). All four are required. If any is unset or
# MADIRA_PUBLIC_URL is not an origin, /login says Google sign-in isn't configured.
# Set them on the backend process. Do not put the client secret on the frontend.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MADIRA_AUTH_SECRET=
# MADIRA_PUBLIC_URL=http://localhost:3000
#
# MADIRA_PUBLIC_URL is the origin the browser uses, with no path and no trailing slash.
# It must match a redirect URI registered on the Google Cloud OAuth client
# (Web application), exactly:
#   http://localhost:3000/madira-api/auth/callback
#   http://127.0.0.1:3000/madira-api/auth/callback
#   https://madira-web-production.up.railway.app/madira-api/auth/callback
# Use http://127.0.0.1:3000 when you open the app on that host (Playwright does).
# Production: MADIRA_PUBLIC_URL=https://madira-web-production.up.railway.app
